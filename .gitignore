# Ignore IDE/editor-specific files
.agent/
.idea/
.vscode/

# Ignore Node modules directories
node_modules/

# Ignore Wrangler directories
.wrangler/

# Ignore macOS system files
.DS_Store

# Ignore built and temporary files
*.bak
*.log
*.po~
*.swp
*.tmp
*.zip

# Ignore Python bytecode and caches
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
__pycache__/